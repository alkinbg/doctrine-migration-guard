{
  "name": "alkinbg/doctrine-migration-guard",
  "description": "CI-first static risk analysis for Doctrine migrations on MySQL and MariaDB.",
  "type": "library",
  "keywords": [
    "ci",
    "doctrine",
    "mariadb",
    "migrations",
    "mysql",
    "static analysis"
  ],
  "homepage": "https://github.com/alkinbg/doctrine-migration-guard",
  "license": "MIT",
  "authors": [
    {
      "name": "Alkin Fehim",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/alkinbg/doctrine-migration-guard/issues",
    "source": "https://github.com/alkinbg/doctrine-migration-guard"
  },
  "require": {
    "php": ">=8.1",
    "nikic/php-parser": "^5.8",
    "symfony/console": "^6.4 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "doctrine/migrations": "^3.9",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "AlkinBG\\DoctrineMigrationGuard\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AlkinBG\\DoctrineMigrationGuard\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/doctrine-migration-guard"
  ],
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist",
    "check": [
      "@test",
      "@analyse"
    ]
  }
}
